{
  "name": "interntrack-portal",
  "version": "1.0.0",
  "description": "InternTrack — Student Internship and Project Management Portal (MERN Stack)",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "start": "npm --prefix server start"
  },
  "keywords": [
    "mern",
    "internship",
    "react",
    "express",
    "mongodb",
    "tailwind"
  ],
  "author": "InternTrack Team",
  "license": "MIT"
}
